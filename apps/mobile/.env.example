# Public SDK keys only. Never put RevenueCat secret keys or store credentials here.
# Copy to ignored .env.local for development. Explicit modes: store, test-store, mock.
EXPO_PUBLIC_REVENUECAT_MODE=store
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Debug builds always use Google test units, even if live is selected accidentally.
EXPO_PUBLIC_ADS_MODE=test
# Native app, banner and interstitial IDs are centralized in release/monetization.json.
# Owner EAS project UUID; required for store-test and production.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SUBSCRIPTION_PROVIDER=revenuecat
# Reviewer code/hash/generation are SERVER secrets, never EXPO_PUBLIC variables.
