# PUBLIC client configuration. Never put store private keys or service-account JSON here.
# Copy to ignored .env.local. Empty RevenueCat keys use a no-charge mock in __DEV__ only.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# test is the default; live requires configured production IDs and launch acceptance.
EXPO_PUBLIC_ADS_MODE=test
# Empty app IDs fall back to official Google demo app IDs in native config.
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
