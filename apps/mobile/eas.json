{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": { "image": "macos-tahoe-26.5-xcode-26.6" },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "image": "macos-tahoe-26.5-xcode-26.6" },
      "env": {
        "INOUT_RELEASE": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "simulator": {
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": true
      },
      "distribution": "internal"
    }
  }
}
