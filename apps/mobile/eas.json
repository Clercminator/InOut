{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "env": {
        "INOUT_RELEASE": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_REVENUECAT_MODE": "store",
        "EXPO_PUBLIC_SUBSCRIPTION_PROVIDER": "revenuecat",
        "EXPO_PUBLIC_ADS_MODE": "live"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "simulator": {
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": true
      },
      "distribution": "internal"
    },
    "store-test": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "INOUT_STORE_TEST": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SUBSCRIPTION_PROVIDER": "revenuecat",
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_REVENUECAT_MODE": "store"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "credentialsSource": "remote"
      }
    }
  }
}
