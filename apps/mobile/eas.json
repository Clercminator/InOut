{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": false,
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "credentialsSource": "remote"
      },
      "env": {
        "INOUT_RELEASE": "1",
        "INOUT_ARTIFACT_ONLY": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_REVENUECAT_MODE": "store",
        "EXPO_PUBLIC_SUBSCRIPTION_PROVIDER": "revenuecat",
        "EXPO_PUBLIC_ADS_MODE": "live"
      },
      "android": {
        "buildType": "app-bundle",
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/release/**",
          "android/app/build/{outputs/native-debug-symbols,intermediates/native_symbol_tables}/release/**",
          "android/app/build/generated/sourcemaps/react/release/**"
        ]
      },
      "environment": "production"
    },
    "simulator": {
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": true
      },
      "distribution": "internal"
    },
    "store-test": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "INOUT_STORE_TEST": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SUBSCRIPTION_PROVIDER": "revenuecat",
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_REVENUECAT_MODE": "store"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote",
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/release/**",
          "android/app/build/{outputs/native-debug-symbols,intermediates/native_symbol_tables}/release/**",
          "android/app/build/generated/sourcemaps/react/release/**"
        ]
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "credentialsSource": "remote"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "INOUT_PREVIEW": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_REVENUECAT_MODE": "store",
        "EXPO_PUBLIC_SUBSCRIPTION_PROVIDER": "revenuecat",
        "EXPO_PUBLIC_ADS_MODE": "test"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": true
      }
    }
  }
}
