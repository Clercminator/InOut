{
  "name": "inout",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @inout/mobile --",
    "typecheck": "tsc --noEmit -p apps/mobile/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p supabase/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run locales:check && npm run typecheck && npm test && npm run test:mobile",
    "test:mobile": "npm test -w @inout/mobile",
    "release:check": "node scripts/check-release.mjs",
    "release:pages": "node scripts/build-public-pages.mjs && node scripts/build-shared-web.mjs && node scripts/build-link-associations.mjs",
    "start:go": "npm run start -w @inout/mobile -- --go",
    "start:go:tunnel": "npm run start:go -- --tunnel",
    "locales:build": "node scripts/build-locales.cjs",
    "locales:check": "node scripts/build-locales.cjs --check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-test-renderer": "19.2.3",
    "react": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@expo/ngrok": {
      "uuid": "11.1.1"
    }
  }
}
